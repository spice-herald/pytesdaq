########################################################
#
# Transducer sweep configuration
#
# Frequency and/or amplitude sweep of signal generator
# with data acquisition at each step.
#
# Usage example:
#
#    python bin/run_transducer_sweep.py
#           -c A,B
#           --comment "transducer sweep test"
#
########################################################

[transducer_sweep]

# DAQ driver (default: polaris)
daq_driver = polaris

# sample rate [Hz]
sample_rate = 1250000

# trace length in millisec (ms) or seconds (s)
# Alternatively use "nb_samples" or "nb_cycles"
# nb_cycles computes trace length dynamically from sweep frequency
trace_length = 5s

# voltage range (volts)
voltage_min = -5
voltage_max = 5

# run time per sweep step (can override with frequency_run_time or amplitude_run_time)
sweep_run_time = 5s

# accelerometer gain (optional, ADC to g conversion factor)
#accel_gain = 100

# ------------------------
# Frequency sweep settings
# ------------------------
do_frequency_sweep = True
amplitude_vpp = 0.2
start_frequency_hz = 5
stop_frequency_hz = 200
frequency_points = 50
frequency_spacing = linear
frequency_hold_time = 0s

# optional focus frequencies for denser sampling
#focus_frequencies_hz = 30, 60
#focus_freqs_width_hz = 2.0
#focus_freqs_spacing_hz = 0.2

# optional override for run time per frequency step
#frequency_run_time = 5s

# ------------------------
# Amplitude sweep settings
# ------------------------
do_amplitude_sweep = False
frequency_hz = 50
start_amplitude_vpp = 0.02
stop_amplitude_vpp = 0.2
amplitude_points = 10
amplitude_spacing = linear
amplitude_hold_time = 0s

# optional override for run time per amplitude step
#amplitude_run_time = 5s
